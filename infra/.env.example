# ----------------------------------------------------------------------------
# elemental-erp: copy this to .env and adjust before `docker compose up`.
# ----------------------------------------------------------------------------

# ---- Domains (Caddy will provision Let's Encrypt certs for both) -----------
# For local dev set both to the same hostname like `localhost` and use
# the matching `Caddyfile.dev` profile; values below assume production.
CRM_DOMAIN=crm.example.com
ADMIN_DOMAIN=admin.example.com

# Email used by Caddy for ACME / Let's Encrypt notifications.
ACME_EMAIL=admin@example.com

# ---- Postgres -------------------------------------------------------------
POSTGRES_USER=elemental
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=elemental

# ---- NocoDB ---------------------------------------------------------------
# Public URL the NocoDB UI is served at; must match ADMIN_DOMAIN with scheme.
NC_PUBLIC_URL=https://admin.example.com
# Random long string. Used by NocoDB to sign JWTs. Generate with:
#   openssl rand -hex 48
NC_AUTH_JWT_SECRET=replace-with-a-long-random-string

# Bootstrap admin (used by scripts/seed.ts on first boot).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# ---- Refine CRM frontend --------------------------------------------------
# These are baked into the static build; if you change them, rebuild the
# `crm` image. They are read by Vite's import.meta.env.VITE_*.
VITE_NOCODB_URL=https://admin.example.com
VITE_CRM_BASE_NAME=Elemental CRM
