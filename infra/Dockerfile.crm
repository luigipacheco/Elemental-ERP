# Multi-stage build for the Refine.dev CRM frontend.
# Built once during `docker compose up` and served by nginx behind Caddy.

# ---- builder ----------------------------------------------------------------
FROM node:20-alpine AS builder
WORKDIR /app

ARG VITE_NOCODB_URL
ARG VITE_CRM_BASE_NAME
ENV VITE_NOCODB_URL=${VITE_NOCODB_URL}
ENV VITE_CRM_BASE_NAME=${VITE_CRM_BASE_NAME}

RUN corepack enable && corepack prepare pnpm@9.12.0 --activate

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* turbo.json tsconfig.base.json ./
COPY apps/crm/package.json apps/crm/
COPY packages/sdk/package.json packages/sdk/
COPY packages/ui/package.json packages/ui/
COPY packages/modules/crm/package.json packages/modules/crm/

RUN pnpm install --frozen-lockfile=false

COPY . .
RUN pnpm --filter ./apps/crm... build

# ---- runtime ----------------------------------------------------------------
FROM nginx:1.27-alpine AS runtime
COPY infra/nginx-crm.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/crm/dist /usr/share/nginx/html
EXPOSE 80
