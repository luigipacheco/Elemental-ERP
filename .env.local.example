# -----------------------------------------------------------------------------
# Local dev .env. Copy to `.env` at the repo root before running compose.
# Safe to use as-is on a developer machine; do NOT use these values in prod.
# -----------------------------------------------------------------------------

# Caddy domains - irrelevant for local dev because we don't start Caddy.
CRM_DOMAIN=localhost
ADMIN_DOMAIN=localhost
ACME_EMAIL=local@example.com

# ---- Postgres ------------------------------------------------------------
POSTGRES_USER=elemental
POSTGRES_PASSWORD=elementalpass
POSTGRES_DB=elemental

# ---- NocoDB --------------------------------------------------------------
NC_PUBLIC_URL=http://localhost:8080
# Random local secret - replace with `openssl rand -hex 48` if you care.
NC_AUTH_JWT_SECRET=dev-only-secret-not-for-production-please-change-me-in-real-deployments

# Bootstrap admin user (created by scripts/seed.ts on first run).
ADMIN_EMAIL=admin@elemental.local
ADMIN_PASSWORD=admin12345

# ---- Refine CRM frontend (read by Vite at build/dev time) ---------------
VITE_NOCODB_URL=http://localhost:8080
VITE_CRM_BASE_NAME=Elemental CRM (local)
